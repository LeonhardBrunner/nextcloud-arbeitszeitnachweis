{
	"name": "nextcloud/timesheet",
	"description": "Arbeitszeitnachweis (MA + HR) für Nextcloud",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "David Gun",
			"email": "dgu@xiller.com"
		}
	],
	"autoload": {
		"psr-4": {
			"OCA\\Timesheet\\": "lib/"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@composer bin all install --ansi"
		],
		"post-update-cmd": [
			"@composer bin all install --ansi"
		],
		"lint": "@php tools/check-php-syntax.php",
		"cs:check": "php-cs-fixer fix --config=tools/php/code-style.php --dry-run --diff",
		"cs:fix": "php-cs-fixer fix --config=tools/php/code-style.php",
		"psalm": "psalm --config=tools/php/static-analysis.xml --threads=1 --no-cache",
		"test:unit": "phpunit tests -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky",
		"rector": "rector process --config=tools/php/modernize-code.php --dry-run"
	},
	"require": {
		"php": ">=8.2 <=8.5",
		"bamarni/composer-bin-plugin": "^1.8",
		"phpoffice/phpspreadsheet": "^5.3",
		"maennchen/zipstream-php": "2.4.0"
	},
	"require-dev": {
		"christophwurst/nextcloud": "^14.0",
		"nextcloud/ocp": "dev-stable30",
		"roave/security-advisories": "dev-latest"
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.2"
		}
	},
	"scripts-descriptions": {
		"lint": "Check PHP syntax in app and tool files.",
		"cs:check": "Show PHP code style differences without changing files.",
		"cs:fix": "Apply the configured PHP code style.",
		"psalm": "Check PHP code for possible errors.",
		"test:unit": "Run app tests inside the Nextcloud test environment.",
		"rector": "Show PHP modernization suggestions without changing files."
	}
}
